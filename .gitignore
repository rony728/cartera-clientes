# Dependencias en cualquier aplicación del monorepo
node_modules/

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Credenciales, llaves y cachés de autenticación alternativos
**/*auth-cache*.json
**/*token-cache*.json
**/*credentials*.json
**/*secrets*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Copias y volcados de datos locales
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Cachés, tokens y archivos temporales
**/.cache/
**/.tmp/
**/tmp/
**/msal-cache.json
**/*.msal-cache.json
*.log
npm-debug.log*

# Salidas comunes de herramientas
coverage/
dist/
build/
test-results/
*.tsbuildinfo
vite.config.js
vite.config.d.ts
