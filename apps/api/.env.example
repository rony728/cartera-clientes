# ID público de la aplicación registrada en Microsoft Entra
MS_CLIENT_ID=c562e3d4-bc99-40f7-9bca-e413a1a3d90b

# La API queda accesible solo desde este dispositivo
HOST=127.0.0.1
PORT=3005

# Clave temporal para proteger la API durante las pruebas
API_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Sesiones web persistentes. Usa un valor aleatorio de al menos 32 caracteres.
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
SESSION_COOKIE_NAME=cartera.sid
SESSION_MAX_AGE_MS=28800000
# En producción HTTPS detrás de Cloudflare debe ser true.
COOKIE_SECURE=false
# Usa none únicamente para frontend/API en sitios distintos y con COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
# Lista separada por comas. Vacío bloquea solicitudes CORS de otros orígenes.
CORS_ORIGINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# PostgreSQL local (no usar el usuario postgres desde la API)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cartera_clientes
DB_USER=cartera_clientes_api
DB_PASSWORD=

# Importación manual de snapshots (deshabilitada hasta tener autorización ADMIN)
SNAPSHOT_IMPORT_ENABLED=false
SNAPSHOT_PATH=/ruta/privada/cartera-snapshot/snapshot.json
# Vacío si el JSON raíz es un arreglo; usa una ruta como value si está anidado.
SNAPSHOT_RECORDS_PATH=
SNAPSHOT_MAX_BYTES=10485760

# Correo que recibirá el mensaje de prueba
MAIL_TO=destinatario@ejemplo.com

# Opcionales
MAIL_SUBJECT=ACTUALIZAR_CARTERA|00000000|99999999
MAIL_BODY=Solicitud de actualización de cartera.
# Ruta del caché persistente de MSAL. Por defecto queda fuera del proyecto.
# MS_TOKEN_CACHE_PATH=/data/data/com.termux/files/home/.config/cartera-clientes-api/msal-cache.json
